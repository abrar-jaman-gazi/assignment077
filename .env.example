# App origin used by Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Local development database (the app creates/uses local.db)
DATABASE_URL=file:./local.db
# Required for a hosted Turso/libSQL database
# DATABASE_AUTH_TOKEN=replace-with-your-turso-token

# Optional social sign-in credentials
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: override the public product API base URL
# NEXT_PUBLIC_API_URL=https://api.api-store.workers.dev/api/bazardor
